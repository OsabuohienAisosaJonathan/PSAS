# Environment Configuration for PSAS
# Copy this file to .env and adjust values as needed

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database (choose one)
# ─────────────────────────────────────────────
# SQLite (default — zero configuration needed):
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/psas.sqlite

# PostgreSQL (production):
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psas

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET=psas-research-grade-jwt-secret-change-in-production-2026

# ─────────────────────────────────────────────
# Admin Seed Credentials
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@psas.local
ADMIN_INITIAL_PASSWORD=Admin2026!ResearchSecure
